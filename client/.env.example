# ==============================================================================
# TutorHub Client Environment Variables
# ==============================================================================
# Copy this file to .env for local development. Never commit .env to version control.
# ==============================================================================

# Backend API target URL used by the Vite dev proxy (local default: http://localhost:3000)
VITE_API_TARGET="http://localhost:3000"

# Set to "true" to force mock in-memory/localStorage data mode instead of calling the live API
VITE_USE_MOCK="false"

# Development tools toggle: show DemoToolbar in production if explicitly set to "true"
VITE_ENABLE_DEMO_TOOLBAR="false"

# Development hints toggle: display seed accounts and password hints on login screen in production if set to "true"
VITE_SHOW_DEV_HINTS="false"
