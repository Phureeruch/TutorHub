# ==============================================================================
# TutorHub Server Environment Variables
# ==============================================================================
# Copy this file to .env for local development. Never commit .env to version control.
# In Google Cloud Run, these settings come from Cloud Run environment variables and Secret Manager.
# ==============================================================================

# Server listening port (default: 3000; Cloud Run sets this automatically)
PORT=3000

# Runtime mode ("development" | "production" | "test")
# The cloud deployment uses "production"
NODE_ENV=development

# PostgreSQL connection string
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5433/tutorhub?schema=public"
# Cloud Run (via Secret Manager tutorhub-database-url):
# DATABASE_URL="postgresql://tutorhub:<PASS>@localhost/tutorhub?host=/cloudsql/PROJECT:REGION:INSTANCE&schema=public"

# Secret key for signing and verifying JWT authentication tokens (minimum 32 characters)
# Generate securely with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-jwt-secret-min-32-chars"

# Initial admin password for the seed script (required in production, stored in Secret Manager)
# In development, defaults to "password123" if left unset
ADMIN_PASSWORD="change-me-admin-password"

# Optional demo accounts password for the seed script (stored in Secret Manager)
# In development, defaults to "password123" if left unset
DEMO_USER_PASSWORD="change-me-demo-password"

# Toggle seeding of demo accounts (true | false)
SEED_DEMO_DATA=true

# Allowed web origin for CORS (optional)
CORS_ORIGIN="http://localhost:5173"

# Optional path to built frontend static files (production default: ../client/dist)
# CLIENT_DIST_DIR="../client/dist"
