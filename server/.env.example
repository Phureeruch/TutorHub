# Copy to .env and adjust for your machine. Never commit .env.

# PostgreSQL from docker-compose.yml (host port 5433 -> container 5432).
DATABASE_URL="postgresql://postgres:password@localhost:5433/tutorhub?schema=public"

# Secret used to sign login tokens (JWT). Use any long random string locally.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express API listens on. The client's Vite dev proxy expects 3000.
PORT=3000

# Directory where uploaded lecture files are stored (outside the web root).
UPLOAD_DIR="uploads"
