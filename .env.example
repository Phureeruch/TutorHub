# ==============================================================================
# TutorHub Docker Compose Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env in the project root:
#      cp .env.example .env
# 2. For local development, the non-empty placeholders below provide safe defaults.
#    In staging or production deployments (e.g. Google Cloud Run), all secrets
#    must be replaced with real credentials supplied via Google Secret Manager.
# ==============================================================================

# Database Configuration (PostgreSQL 15)
# NOTE: Default values are for local Docker Compose development ONLY.
# Production environments must supply strong credentials via Google Secret Manager.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_password_dev_only
POSTGRES_DB=tutorhub

# Backend Authentication & Security
# NOTE: Default value is for local Docker Compose development ONLY.
# Production environments must supply a secure, 32+ byte secret via Secret Manager.
JWT_SECRET=local_dev_jwt_secret_change_in_production_32chars!

# Seed Configuration
# Initial password for the administrator account (admin@tutorhub.dev)
# NOTE: Default value is for local Docker Compose development ONLY.
ADMIN_PASSWORD=local_admin_password_dev_only

# Toggle seeding of demo data (false = admin and subjects only; true = full demo data)
SEED_DEMO_DATA=false

# Optional password for demo users if SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=local_demo_password_dev_only

# Allowed web origins for CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
