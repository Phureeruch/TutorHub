# ==============================================================================
# TutorHub Docker Compose Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env in the project root:
#      cp .env.example .env
# 2. Fill in all required secret values before running Docker Compose.
#    Compose validation (${VARIABLE:?}) will fail until valid values are supplied.
# ==============================================================================

# Database Configuration (PostgreSQL 15)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tutorhub

# Backend Authentication & Security
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=

# Seed Configuration
# Initial password for the administrator account (admin@tutorhub.com)
ADMIN_PASSWORD=

# Toggle seeding of demo data (false = admin and subjects only; true = full demo data)
SEED_DEMO_DATA=false

# Optional password for demo users if SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=

# Allowed web origins for CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
